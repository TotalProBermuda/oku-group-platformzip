        "narrative": "Often correlates with long lead times or missing reminders. Spikes can mean comms problems."
      },
      "conversionRate": {
        "label": "Conversion Rate",
        "definition": "Seated reservations divided by total leads.",
        "source": "Computed from total leads and (SEATED + COMPLETED).",
        "narrative": "Topline efficiency. Target 70%+; below 40% signals operational drag worth investigating."
      },
      "avgWait": {
        "label": "Avg Wait to Seat",
        "definition": "Average minutes from arrival confirmed to actually seated.",
        "source": "arrivalConfirmedAt → seatedAt across all seated reservations in the window.",
        "narrative": "Rising waits correlate with no-show spikes and bad guest sentiment. Watch this on busy nights."
      },
      "totalInteractions": {
        "label": "Total Interactions",
        "definition": "Every attribution event captured across all zones.",
        "source": "Zone-level attribution rows in the selected window.",
        "narrative": "Total guest engagement — the top of every zone funnel."
      },
      "totalPatronized": {
        "label": "Total Patronized",
        "definition": "Guests who were seated and served across all zones.",
        "source": "Attribution rows that reached PATRONIZED.",
        "narrative": "Aggregate revenue-bearing visits — the success rate of the venue overall."
      },
      "globalConversion": {
        "label": "Global Conversion",
        "definition": "Patronized divided by Total Interactions across all zones.",
        "source": "Computed from zone scorecards.",
        "narrative": "Cross-concept efficiency — diverging zone rates point to where to invest host effort."
      },
      "operationalLosses": {
        "label": "Operational Losses",
        "definition": "Losses caused by the venue (waits, no tables, broken elevator, etc.).",
        "source": "Loss reasons flagged as operational.",
        "narrative": "Inside-our-control losses — the most actionable category. Push this number down."
      }
    }
  },

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/dbname"

NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Exact Google Workspace email that may bootstrap and retain the protected
# SUPERADMIN owner account on first production sign-in.
PRIMARY_SUPERADMIN_EMAIL=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

AUTHORIZE_NET_API_LOGIN_ID=""
AUTHORIZE_NET_TRANSACTION_KEY=""
AUTHORIZE_NET_ENV="sandbox" # sandbox|production

REDIS_URL="rediss://:password@host:port"
# Upstash REST alternative (recommended for serverless deployments).
# Either set this pair, or use the compatibility HOST/TOKEN pair below.
UPSTASH_REDIS_REST_URL="https://your-upstash-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"
# Compatibility names used by the Replit setup; HOST may be supplied with or without https://.
UPSTASH_REDIS_HOST="your-upstash-endpoint.upstash.io"
UPSTASH_REDIS_TOKEN="your-upstash-rest-token"

APP_BASE_URL="http://localhost:3000"

# Demo back-doors (password-less @oku.local sign-in + SUPERADMIN free-ticket
# checkout). Gated behind BOTH NODE_ENV != "production" AND this flag set
# to "true". Leave UNSET in production. Set to "true" in development and
# preview environments where you want the demo experience to work.
DEMO_MODE_ENABLED="true"

# Optional: short git SHA for the deployed build. Surfaced as `release`
# in every error capture so log filters can isolate per-deploy regressions.
RELEASE_SHA=""

# Optional: when set, the error reporter could be swapped for Sentry.
# See src/server/errorReporting.ts for the one-line integration point.
SENTRY_DSN=""

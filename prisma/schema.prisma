  INACTIVE
  ARCHIVED
}

enum AccountProfileRelationship {
  OWNER
  MANAGER
  MEMBER
  REPRESENTATIVE
  HOST
  EDITOR
  VIEWER
  BILLING_CONTACT
}

enum ProfileRelationshipType {
  MEMBER_OF
  REPRESENTS
  OWNS
  SUBSIDIARY_OF
  PARTNER_OF

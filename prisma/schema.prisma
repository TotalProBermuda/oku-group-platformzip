model Order {
  id        String      @id @default(cuid())
  userId    String
  seriesId  String
  sessionId String
  status    OrderStatus @default(PENDING)

  // Intelligence fields
  orderType         OrderType    @default(TICKET)
  channel           OrderChannel @default(DIRECT)
  orderNumber       String?      @unique
  fulfillmentStatus String?

  subtotalCents   Int
  feesCents       Int    @default(0)
  taxCents        Int    @default(0)
  totalCents      Int
  discountCents   Int    @default(0)
  commissionCents Int    @default(0)
  netRevenueCents Int    @default(0)
  currency        String @default("USD")

  coversCount Int @default(1)

  couponCode             String?
  attributedInfluencerId String?
  attributionId          String?

  // Event referrer attribution (separate from CompensationPlan walk-in referrers)
  attributedEventReferrerAssignmentId String?
  // Unified attribution: ReferralAssignment captured the click that led to
  // this order. Coexists with the legacy attributedEventReferrerAssignmentId
  // during the migration window — both may be set for the same order.
  attributedReferralAssignmentId      String?
  attributionSource                   AttributionSource @default(DIRECT)

  placedAt    DateTime?
  paidAt      DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  series  Series  @relation(fields: [seriesId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])

  payment   Payment?
  lineItems OrderLineItem[]
  tickets   Ticket[]

  attributedInfluencer              InfluencerProfile?              @relation(fields: [attributedInfluencerId], references: [id])
  attribution                       Attribution?                    @relation(fields: [attributionId], references: [id])
  attributedEventReferrerAssignment EventReferrerAssignment?        @relation(fields: [attributedEventReferrerAssignmentId], references: [id])
  attributedReferralAssignment      ReferralAssignment?             @relation("OrderReferralAssignment", fields: [attributedReferralAssignmentId], references: [id])
  LedgerEntry                       LedgerEntry[]
  subCommissionLedger               InfluencerSubCommissionLedger[]
  events                            OrderEvent[]
  notes                             OrderNote[]
  // Attribution session written at ticket-purchase time (TICKET_PURCHASE sessions only).
  attributionSession                AttributionSession?             @relation("AttributionSessionOrder")

  @@index([userId, createdAt])
  @@index([seriesId])
  @@index([sessionId])
  @@index([orderNumber])
  @@index([status, createdAt])
  @@index([channel])
  @@index([orderType])
}


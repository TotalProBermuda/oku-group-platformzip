model Profile {
  id          String      @id @default(cuid())
  profileType ProfileType
  displayName String
  legalName   String?
  slug        String?     @unique

  primaryCategory String?
  categories      String[] @default([])

  bio              String?
  shortDescription String?

  email        String?
  phone        String?
  websiteUrl   String?
  instagramUrl String?
  twitterUrl   String?

  avatarUrl     String?
  logoUrl       String?
  coverImageUrl String?

  publicVisible        Boolean @default(false)
  compensationEligible Boolean @default(false)
  assignableToSeries   Boolean @default(true)
  assignableToSessions Boolean @default(true)

  status   ProfileStatus @default(ACTIVE)
  metadata Json          @default("{}")

  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt


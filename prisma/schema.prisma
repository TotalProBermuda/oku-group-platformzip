  INVOICE_TOTALS
  PAYMENTS
  CLIENTS
  CREDIT_NOTES
  REVERSALS
  ORDER_TOTALS
  MANUAL_TEST
  ALL
}

enum SyncRunStatus {
  STARTED
  SUCCESS
  PARTIAL_FAILURE
  FAILED
}

enum MatchMethod {
  AUTO
  MANUAL
  UNMATCHED
}

enum TableSessionStatus {

model CommissionEntry {
  id            String           @id @default(cuid())
  referrerId    String
  reservationId String?
  amountCents   Int
  currency      String           @default("USD")
  status        CommissionStatus @default(PENDING)
  reason        String?
  covers        Int?
  conceptKey    String?

  // Native v2 attribution: when set, the commission was attributed to a
  // ReferralActor directly. Legacy rows (pre-v2) leave this null and are
  // attributed via `referrerId → ReferralActor.legacyReferrerId`.
  //
  // WRITE CONTRACT: when minting a commission for a Referrer that has a
  // linked ReferralActor (i.e. `Referrer.referralActor` is not null),
  // writers MUST populate BOTH `referrerId` and `referralActorId`. Read
  // surfaces resolve the earner via `commissionWhereForEarner` in
  // `src/server/commissions/earnerScope.ts`, which OR's the two FKs and
  // de-duplicates by row id — so dual-write is safe and is the canonical
  // form. Single-FK writes are tolerated for back-compat but will UNDER-
  // COUNT in any future surface that switches its primary lookup FK.
  referralActorId String?
  referralActor   ReferralActor? @relation(fields: [referralActorId], references: [id])

  referrer    Referrer     @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerId, status])
  @@index([reservationId])
  @@index([referralActorId, status])
}

model CommissionSuggestion {

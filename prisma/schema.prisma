  earlyReleaseAt  DateTime?

  // Privacy & Access Controls
  seriesVisibilityMode        SeriesVisibilityMode @default(PUBLIC)
  allowInviteOnlyAccess       Boolean              @default(false)
  allowReferrerAccess         Boolean              @default(false)

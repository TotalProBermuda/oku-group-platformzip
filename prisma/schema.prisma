/// Banesco-targeted Beneficiary Verification profile.
///
/// **Important**: OKÜ is NOT the formal KYC/AML authority — Banesco performs
/// formal KYC. This model captures the information OKÜ Finance needs to
/// internally approve a beneficiary AND the bank-required information needed
/// before a payout file can be released. Three concepts are intentionally
/// kept separate:
///   1. OKÜ approval        → `bankReadinessStatus` ∈ {OKU_APPROVED, ...}
///   2. Bank readiness      → `bankReadinessStatus == BANK_READY`
///   3. Payout eligibility  → derived (BANK_READY + no compliance hold)
///
/// Document upload is OUT OF SCOPE for P1; only structured status flags +
/// admin notes are persisted. Uploads ship in a follow-up once Banesco's
/// exact document requirements are confirmed.
model BeneficiaryProfile {
  id     String @id @default(cuid())
  userId String @unique

  // ── Banesco bank coordinates (account # AES-256-GCM encrypted) ──
  banescoAccountNumberEncrypted String?
  banescoAccountLast4           String?
  bankName                      String?
  accountHolderName             String?
  accountType                   BankAccountType?
  currency                      String           @default("USD")
  swiftBic                      String?

  // ── Document status flags (no uploads in P1) ──
  proofOfAddressStatus BeneficiaryDocStatus @default(MISSING)
  identificationStatus BeneficiaryDocStatus @default(MISSING)
  taxOrRucStatus       BeneficiaryDocStatus @default(MISSING)
  sourceOfFundsStatus  BeneficiaryDocStatus @default(NOT_REQUIRED)

  incomeCertificationRequired  Boolean   @default(false)
  incomeCertificationExpiresAt DateTime?

  // ── State machine + holds ──
  bankReadinessStatus    BankReadinessStatus @default(MISSING_INFO)
  complianceHoldReason   String?
  adminVerificationNotes String?

  /// Beneficiary preference: when true, suppress informational status-change
  /// emails (READY_FOR_REVIEW, OKU_APPROVED, BANK_READY). Action-required
  /// transitions (ON_HOLD, REJECTED) IGNORE this flag and always send.
  statusEmailOptOut      Boolean @default(false)

  // ── Audit trail (lightweight; full history goes to AuditLog) ──
  okuApprovedAt   DateTime?
  okuApprovedById String?
  bankReadyAt     DateTime?
  bankReadyById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  okuApprovedBy User? @relation("BeneficiaryOkuApprover", fields: [okuApprovedById], references: [id])
  bankReadyBy   User? @relation("BeneficiaryBankConfirmer", fields: [bankReadyById], references: [id])

  documents BeneficiaryDocument[]

  @@index([bankReadinessStatus])
}

/// Files uploaded by beneficiaries (or by Finance on their behalf) as
/// supporting evidence for a `BeneficiaryDocStatus`. The status flag and the
/// uploaded file are intentionally orthogonal: an admin still has to mark the
/// document VERIFIED — uploads are only evidence. Files live in private
/// object storage (`/<bucket>/private/beneficiary-docs/<profileId>/<uuid>`)
/// and are never reachable through the public media proxy.
model BeneficiaryDocument {
  id          String                   @id @default(cuid())
  profileId   String
  docType     BeneficiaryDocumentType
  filename    String
  contentType String
  sizeBytes   Int
  /// Full GCS path including leading bucket segment, e.g.
  /// `/replit-objstore-.../private/beneficiary-docs/<profileId>/<uuid>.pdf`
  objectPath  String                   @unique
  scanStatus  BeneficiaryDocScanStatus @default(PENDING)
  scanMessage String?

  uploadedById String
  uploadedAt   DateTime  @default(now())
  deletedAt    DateTime?


model PayoutBatch {
  id         String            @id @default(cuid())
  status     PayoutBatchStatus @default(DRAFT)
  name       String?
  notes      String?
  currency   String            @default("USD")
  totalCents Int               @default(0)
  lineCount  Int               @default(0)
  from       DateTime
  to         DateTime
  createdAt  DateTime          @default(now())
  closedAt   DateTime?

  // Maker/checker + export trail. All nullable until that step occurs.
  createdById     String?
  submittedAt     DateTime?
  submittedById   String?
  approvedAt      DateTime?
  approvedById    String?
  rejectedAt      DateTime?
  rejectedById    String?
  rejectionReason String?
  exportedAt      DateTime?
  exportedById    String?
  exportFormat    String?
  // Deterministic SHA-256 of the canonical export payload (recipient
  // rows + totals + trace IDs). Lets auditors prove the file delivered
  // to the bank matches what was approved, byte-for-byte.
  exportFileHash  String?
  exportPayload   String?   @db.Text

  entries        LedgerEntry[]
  // Sub-commission rows for event referrers included in this batch (Step 4
  // reconciliation). These are paid by the influencer to their referrer, not
  // by OKU, but the batch tracks when they were settled so the old sub-
  // commission ledger can eventually be retired without orphaning history.
  subCommissions InfluencerSubCommissionLedger[] @relation("SubCommissionPayoutBatch")

  @@index([status])
}


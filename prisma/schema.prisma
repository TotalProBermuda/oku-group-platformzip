  lastSuccessfulSyncAt DateTime?
  lastFailedSyncAt     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  venue      Venue                     @relation(fields: [venueId], references: [id])

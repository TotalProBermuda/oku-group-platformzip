  gates     Json
  checkedAt DateTime @default(now())

  @@index([checkedAt])
}

// Encrypted gateway credentials. Secrets are AES-256-GCM-encrypted with
// APP_ENCRYPTION_KEY before write; only last4 hints are stored unmasked.
// Never expose the *Encrypted fields to clients.
model PaymentGatewayCredential {
  id String @id @default(cuid())

  provider       String  @default("AUTHORIZE_NET")
  label          String  @default("Authorize.net Credit Card")
  isActive       Boolean @default(true)
  environment    String  @default("sandbox") // sandbox | production
  connectionType String  @default("gateway_only") // gateway_only | all_in_one

  apiLoginIdEncrypted     String?
  transactionKeyEncrypted String?
  signatureKeyEncrypted   String?

  apiLoginIdLast4     String?
  transactionKeyLast4 String?
  signatureKeyLast4   String?

  merchantProviderName String?
  merchantIdLast4      String?
  terminalIdLast4      String?

  checkoutTitle       String  @default("Credit Card")
  checkoutDescription String  @default("Pay securely using your credit card.")
  enableGateway       Boolean @default(false)
  displayCsc          Boolean @default(true)
  transactionType     String  @default("charge") // charge | authorize_only
  detailedDeclines    Boolean @default(true)
  debugMode           String  @default("off") // off | errors | verbose
  acceptedCardLogos   Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@unique([provider])
}

// Encrypted Cybersource (REST API) gateway credentials. Mirrors the
// PaymentGatewayCredential pattern: secrets are AES-256-GCM-encrypted with
// APP_ENCRYPTION_KEY before write; only last4 hints are stored unmasked.
// Singleton — there is at most one row per provider; we use provider as the
// natural unique key.
model CybersourceGatewayCredential {
  id String @id @default(cuid())

  provider    String  @unique @default("CYBERSOURCE")
  enabled     Boolean @default(false)
  environment String  @default("test") // test | production

  merchantIdEncrypted     String?
  keyIdEncrypted          String?
  sharedSecretEncrypted   String?
  organizationIdEncrypted String?
  portfolioIdEncrypted    String?

  merchantIdLast4     String?
  keyIdLast4          String?
  sharedSecretLast4   String?
  organizationIdLast4 String?
  portfolioIdLast4    String?

  // Non-secret display / behaviour
  checkoutTitle                  String  @default("Credit Card")
  checkoutDescription            String  @default("Pay securely using your credit card.")
  acceptedCardLogos              Json?
  cardSecurityCodeEnabled        Boolean @default(true)
  detailedDeclineMessagesEnabled Boolean @default(true)
  debugMode                      String  @default("OFF") // OFF | ERRORS_ONLY | VERBOSE

  // Last test
  lastTestStatus  String? // passed | failed
  lastTestMessage String?
  lastTestedAt    DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?
}

enum StoreStatus {
  OPEN
  CLOSED
  TEST_MODE
}

enum DebugMode {
  OFF
  ERRORS_ONLY
  VERBOSE
}

// Payments P4/P5/P5a — which provider /api/v1/checkout/confirm uses for new
// charges. Both providers are real adapters (P5); selectability is driven by
// per-provider readiness + last-passing test recency. Refund/void routing is
// always by Payment.provider on the original record, never by this enum.
//
// NOTE for future tenant-aware refactors: do NOT change the schema default to
// CYBERSOURCE. ReferrerOS markets must explicitly choose their active gateway
// — the OKÜ Panama row is flipped to CYBERSOURCE by an idempotent seed step.
enum ActiveCheckoutGateway {
  AUTHORIZE_NET
  CYBERSOURCE
}

// Singleton: always upsert with id = "global". Stores non-secret commerce
// settings only — never API keys or secrets.
model CommerceSettings {
  id                           String                @id @default("global")
  businessName                 String?
  addressLine1                 String?
  addressLine2                 String?
  city                         String?
  countryRegion                String?
  currency                     String                @default("USD")
  timezone                     String                @default("America/Panama")
  storeStatus                  StoreStatus           @default(OPEN)
  capacityManagementEnabled    Boolean               @default(true)
  holdMinutes                  Int                   @default(15)
  lowStockThreshold            Int                   @default(10)
  soldOutThreshold             Int                   @default(0)
  stockNotificationEmails      String[]              @default([])
  hideSoldOutTicketTypes       Boolean               @default(false)
  allowGuestCheckout           Boolean               @default(true)
  requireAccountForMemberships Boolean               @default(true)
  continueShoppingDestination  String                @default("/series")
  emptyCartText                String?
  checkoutSupportEmail         String?
  cancellationPolicyText       String?
  senderName                   String?
  adminNotificationEmails      String[]              @default([])
  debugMode                    DebugMode             @default(OFF)
  activeCheckoutGateway        ActiveCheckoutGateway @default(AUTHORIZE_NET)
  updatedById                  String?
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
}


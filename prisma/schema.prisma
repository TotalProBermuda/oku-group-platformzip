model Reservation {
  id             String            @id @default(cuid())
  venueId        String
  zoneId         String?
  guestProfileId String?
  source         ReservationSource
  status         ReservationStatus @default(PENDING)

  reservationDate     DateTime
  partySize           Int
  durationMinutes     Int?
  conceptRequested    String?
  occasion            String?
  seatingPreference   String?
  notes               String?
  dietaryRestrictions String?
  specialRequests     String?

  bringOwnBottle     Boolean @default(false)
  corkageBottleCount Int?
  corkageFeeCents    Int?

  celebrationDessert Boolean @default(false)
  celebrationMessage String?

  contactName      String
  contactEmail     String
  contactPhone     String?
  contactWhatsapp  String?
  confirmationCode String  @unique
  sourceContext    String?

  estimatedRevenueCents Int?
  actualRevenueCents    Int?

  assignedTableLabel       String?
  assignedRestaurantHostId String?
  commissionEligible       Boolean   @default(false)
  commissionValidatedAt    DateTime?
  arrivalConfirmedAt       DateTime?
  // Partial-arrival headcount (Apr 28 2026). Null when the whole party
  // arrived at once (most cases); set to N when only N of partySize
  // showed up at the time of scan/check-in. Drives the closed-card
  // headcount summary and the host's at-a-glance "3/5 arrived" pill.
  arrivedHeadcount         Int?
  seatedAt                 DateTime?

  // Space-aware capacity (Task #181). The referrer/guest requests a space;
  // the host may assign a different one. Attribution is keyed on the session,
  // not the space — space reassignment NEVER touches referrer anchors.
  requestedSpaceId String?
  assignedSpaceId  String?

  venue          Venue                  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  zone           Zone?                  @relation(fields: [zoneId], references: [id])
  guestProfile   ResGuestProfile?       @relation(fields: [guestProfileId], references: [id])
  assignedHost   RestaurantHostProfile? @relation(fields: [assignedRestaurantHostId], references: [id])
  requestedSpace RestaurantSpace?       @relation("ReservationRequestedSpace", fields: [requestedSpaceId], references: [id])
  assignedSpace  RestaurantSpace?       @relation("ReservationAssignedSpace", fields: [assignedSpaceId], references: [id])

  addons                ReservationAddon[]
  communications        ReservationCommunication[]
  attributions          ReservationAttribution[]
  handoffs              ReservationHandoff[]
  commissions           CommissionEntry[]
  commissionSuggestions CommissionSuggestion[]
  benefits              ReferralBenefit[]
  statusLogs            ReservationStatusLog[]
  chatSessions          HostChatSession[]
  tableSessions         TableSession[]
  attributionSession    AttributionSession?        @relation("ReservationAttributionSession")
  matchProofs           MatchProof[]
  ledgerEvents          LedgerEvent[]              @relation("LedgerEventReservation")
  capacityHolds         CapacityHold[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId, reservationDate])
  @@index([zoneId, reservationDate])
  @@index([status])
  @@index([contactEmail])
  @@index([requestedSpaceId])
  @@index([assignedSpaceId])
}


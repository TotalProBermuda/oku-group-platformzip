  invuReferenceWritten   Boolean                     @default(false)
  invuReferenceWrittenAt DateTime?
  invuReferenceField     String?
  openedInvuOrderId      String?
  matchTier              MatchTier?
  matchStatus            DeterministicMatchStatus    @default(UNMATCHED)
  matchConfidence        Float                       @default(0)
  matchProofId           String?                     @unique
  syncStatus             InvuSyncStatus              @default(NOT_SEEN)
  commissionEligibility  CommissionEligibilityStatus @default(NOT_ELIGIBLE)

  reservation        Reservation?           @relation(fields: [reservationId], references: [id])
  venue              Venue                  @relation(fields: [venueId], references: [id])
  allocations        CommissionAllocation[]
  attributionSession AttributionSession?    @relation("AttributionToTableSession", fields: [attributionSessionId], references: [id])
  matchProof         MatchProof?            @relation(fields: [matchProofId], references: [id])
  manualOverride     ManualMatchOverride?
  invuOrders         InvuOrderNormalized[]  @relation("TableSessionInvuOrders")

  @@index([venueId])
  @@index([venueId, closedAt])
  @@index([reservationId])
  @@index([invuOrderId])
  @@index([status])
  @@index([matchMethod])
  @@index([matchStatus])
  @@index([syncStatus])
  @@index([commissionEligibility])
  @@index([openedInvuOrderId])
}

model CommissionAllocation {
  id                     String                     @id @default(cuid())
  tableSessionId         String
  earnerType             EarnerType
  earnerRefId            String
  amountCents            Int
  currency               String                     @default("USD")
  status                 CommissionAllocationStatus @default(PENDING)
  commissionRuleSnapshot Json
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  tableSession TableSession  @relation(fields: [tableSessionId], references: [id])
  ledgerEvents LedgerEvent[] @relation("LedgerEventCommissionAllocation")

  // Hard idempotency guard for auto-minting. Re-minting after a REVERSED
  // allocation requires an explicit admin flow that first deletes the old
  // row, which preserves the trust-chain invariant that no two live
  // allocations can ever exist for the same (session, earner) pair.
  @@unique([tableSessionId, earnerType, earnerRefId])
  @@index([tableSessionId])
  @@index([earnerType, earnerRefId])
  @@index([status])
}


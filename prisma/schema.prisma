// ── CHECK-IN + ATTENDANCE SYSTEM ────────────────────────────────────────────

enum AttendanceStatus {
  ARRIVED
  SEATED
  COMPLETED
  LEFT_EARLY
  NO_SHOW
}

enum OutcomeType {
  COMPLETED
  LEFT_EARLY
  NO_SHOW
  DISSATISFIED
  UNKNOWN
}

enum OutcomeReasonCode {
  WAIT_TIME
  SERVICE
  PRICE
  EXPERIENCE
  UNKNOWN
}

enum CheckInResult {
  VALID
  INVALID
  ALREADY_CHECKED_IN
  EXPIRED
}

model AttendanceEvent {
  id               String           @id @default(cuid())
  ticketId         String           @unique
  sessionId        String
  userId           String
  status           AttendanceStatus @default(ARRIVED)
  arrivalTime      DateTime         @default(now())
  seatedTime       DateTime?
  departureTime    DateTime?
  durationMinutes  Int?
  recordedByUserId String
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  ticket     Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  session    Session            @relation(fields: [sessionId], references: [id])
  user       User               @relation("UserAttendances", fields: [userId], references: [id])
  recordedBy User               @relation("AttendanceRecordedBy", fields: [recordedByUserId], references: [id])
  outcome    AttendanceOutcome?

  @@index([sessionId, status])
  @@index([userId])
  @@index([sessionId, arrivalTime])
}

model AttendanceOutcome {
  id                String            @id @default(cuid())
  attendanceEventId String            @unique
  outcomeType       OutcomeType
  reasonCode        OutcomeReasonCode @default(UNKNOWN)
  notes             String?
  createdAt         DateTime          @default(now())

  attendanceEvent AttendanceEvent @relation(fields: [attendanceEventId], references: [id], onDelete: Cascade)
}

model CheckInLog {
  id              String        @id @default(cuid())
  ticketId        String?
  scannedCode     String
  valid           Boolean
  result          CheckInResult

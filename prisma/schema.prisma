// ─── Event Referrer Assignments ───────────────────────────────────────────────
// Influencer-managed referrer network. Separate from CompensationPlan.

model EventReferrerAssignment {
  id                    String                      @id @default(cuid())
  // XOR — exactly one of parentInfluencerId / parentPartnerId is set.
  // Enforced in app layer (Prisma cannot express CHECK constraints).
  parentInfluencerId    String?
  parentPartnerId       String?
  // Streetside hosts are referrers too — employed by the restaurant
  // rather than externally. When this is set (and parentInfluencerId/
  // parentPartnerId are not), the assignment represents a host's
  // personal commission code. Commission is settled by the restaurant
  // off-platform; OKU emits a reporting row only (same shape as
  // partner-anchored seats).
  parentHostProfileId   String?
  createdByInfluencerId String?
  createdByUserId       String?
  seriesId              String?
  scopeType             EventReferrerScopeType      @default(SERIES)
  assignedUserId        String?
  inviteEmail           String?
  displayName           String
  referralCode          String                      @unique
  referralUrl           String?
  qrCodeImageUrl        String?
  isCommissionEligible  Boolean                     @default(false)
  commissionMode        EventReferrerCommissionMode @default(NONE)
  commissionShareBps    Int?
  status                EventReferrerStatus         @default(INVITED)

  commissionPayer           String  @default("OKU")
  commissionEntityProfileId String?
  assignedHostProfileId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentInfluencer    InfluencerProfile?   @relation("ParentInfluencer", fields: [parentInfluencerId], references: [id])
  parentPartner       PartnerProfile?      @relation("PartnerReferrers", fields: [parentPartnerId], references: [id])
  createdByInfluencer InfluencerProfile?   @relation("CreatedByInfluencer", fields: [createdByInfluencerId], references: [id])
  createdByUser       User?                @relation("EventReferrerCreatedByUser", fields: [createdByUserId], references: [id])
  series              Series?              @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  assignedUser        User?                @relation("EventReferrerAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  delegateSeat        PartnerDelegateSeat? @relation("SeatReferrerAssignment")

  commissionEntityProfile Profile?               @relation("EntityCommissionedReferrers", fields: [commissionEntityProfileId], references: [id], onDelete: SetNull)
  assignedHostProfile     RestaurantHostProfile? @relation("HostReferrerAssignments", fields: [assignedHostProfileId], references: [id], onDelete: SetNull)
  // Self-anchor for streetside hosts. The `assignedHostProfile` above
  // is the recipient/operator; `parentHostProfile` is the commission
  // anchor (typically the same host for personal codes).
  parentHostProfile       RestaurantHostProfile? @relation("HostOwnedReferrers", fields: [parentHostProfileId], references: [id], onDelete: SetNull)

  orders              Order[]
  subCommissionLedger InfluencerSubCommissionLedger[]

  referralActor ReferralActor?

  // A streetside host has at most ONE personal commission code,
  // ever. Postgres treats multiple NULLs as distinct, so this only
  // constrains rows that actually use the host anchor (System 3).
  // The provisioning helper handles the "exists but not active"
  // case by reactivating, never by inserting a duplicate.
  @@unique([parentHostProfileId])
  @@index([seriesId, status])
  @@index([parentInfluencerId])
  @@index([referralCode])
  @@index([commissionEntityProfileId])
  @@index([assignedHostProfileId])
}

// ─── Influencer Sub-Commission Ledger ─────────────────────────────────────────
// Tracks what influencers owe their event referrers.
// This is NOT OKU's AP ledger. OKU only pays the influencer.

model InfluencerSubCommissionLedger {
  id                             String                    @id @default(cuid())
  orderId                        String
  seriesId                       String?
  // Anchor: exactly one of parentInfluencerId / parentPartnerId is set
  // (matches the parent on EventReferrerAssignment).
  parentType                     SubCommissionParentType   @default(INFLUENCER)
  parentInfluencerId             String?
  parentPartnerId                String?
  // Mirror of the parent on EventReferrerAssignment for host-anchored
  // (streetside-employed) referrers. The restaurant settles payout
  // off-platform; we record the amount here for reporting only.
  parentHostProfileId            String?
  eventReferrerAssignmentId      String
  ticketAmountCents              Int
  grossInfluencerCommissionCents Int
  referrerShareCents             Int                       @default(0)
  influencerRetainedCents        Int
  currency                       String                    @default("USD")
  // "INFLUENCER" or "PARTNER" — who pays the seat (off-platform).
  payoutResponsibility           String                    @default("INFLUENCER")
  payoutStatus                   SubCommissionPayoutStatus @default(NOT_ELIGIBLE)
  // Frozen snapshot of the commission model at write time so future model
  // edits never rewrite history.
  commissionModelSnapshot        Json?
  notes                          String?
  createdAt                      DateTime                  @default(now())
  // Step 4 reconciliation — once this row is included in a PayoutBatch, the
  // batch id is written here so it can never be double-counted. The payout
  // service reads PENDING rows with payoutBatchId=null to find unbatched work.
  payoutBatchId                  String?

  order                   Order                   @relation(fields: [orderId], references: [id])
  parentInfluencer        InfluencerProfile?      @relation(fields: [parentInfluencerId], references: [id])
  parentPartner           PartnerProfile?         @relation("PartnerSubCommissionLedger", fields: [parentPartnerId], references: [id])
  parentHostProfile       RestaurantHostProfile?  @relation("HostSubCommissionLedger", fields: [parentHostProfileId], references: [id])
  eventReferrerAssignment EventReferrerAssignment @relation(fields: [eventReferrerAssignmentId], references: [id])
  payoutBatch             PayoutBatch?            @relation("SubCommissionPayoutBatch", fields: [payoutBatchId], references: [id])

  @@index([orderId])
  @@index([parentInfluencerId])
  @@index([parentPartnerId])
  @@index([parentHostProfileId])
  @@index([eventReferrerAssignmentId])
  @@index([payoutBatchId])
}

model RestaurantHostProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  displayName String
  isActive    Boolean @default(true)
  badgeColor  String?

  venueId String?

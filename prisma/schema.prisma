  partner         PartnerProfile?    @relation(fields: [partnerId], references: [id])
  commercialOwner InfluencerProfile? @relation("SeriesCommercialOwner", fields: [commercialOwnerInfluencerId], references: [id])

  sessions               Session[]
  ticketTypes            TicketType[]
  Order                  Order[]
  addons                 ExperienceAddon[]
  experienceInfluencer   ExperienceInfluencer[]
  waitlists              ExperienceWaitlist[]
  analyticsDays          ExperienceAnalyticsDaily[]
  eventPermissions       EventPermission[]
  eventReferrers         EventReferrerAssignment[]
  invitations            EventInvitation[]
  registrants            EventRegistrant[]
  seriesHosts            SeriesHost[]
  sponsorshipSlots       SponsorshipSlot[]
  profileAssignments     SeriesProfileAssignment[]
  reservationBlocks      ReservationBlock[]
  influencerInvites      InfluencerInvite[]
  hostInfluencerContacts HostInfluencerContact[]
  eventMenuLinks         EventMenuLink[]
  delegateSeats          PartnerDelegateSeat[]
  eventAccessGrants      UserEventAccess[]

// Persisted point-in-time snapshot of getLaunchReadiness() (Task #131).
// Used by /admin/launch-readiness to show a "Recent history" trend so
// operators can spot gates that flip between pass/fail across deploys.
// Rows older than 90 days are pruned best-effort on each persist call.
model LaunchReadinessSnapshot {
  id        String   @id @default(cuid())
  overall   String   // "GO" | "NO_GO"

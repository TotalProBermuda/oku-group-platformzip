// A named physical dining space within a venue (OKÜ Dining Room, Catch Experience, Terrace, VIP).
// Capacity is enforced using overlapping-window holds (CapacityHold) so concurrent reservations
// that share time slots are counted correctly — not just exact-match windows.
model RestaurantSpace {
  id                 String   @id @default(cuid())
  venueId            String
  name               String
  capacity           Int      // maximum simultaneous covers
  reservable         Boolean  @default(true)
  requiresApproval   Boolean  @default(false)
  weatherSensitive   Boolean  @default(false)
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)

  venue            Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  capacityHolds    CapacityHold[]
  requestedByReservations Reservation[] @relation("ReservationRequestedSpace")
  assignedToReservations  Reservation[] @relation("ReservationAssignedSpace")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, name])
  @@index([venueId])
}

// Tracks covers held in a RestaurantSpace for a given time window.
// Overlap-aware: the capacity check counts all ACTIVE holds whose window
// overlaps the new reservation's window (NOT just exact-match windows).
model CapacityHold {
  id            String              @id @default(cuid())
  spaceId       String
  reservationId String
  startAt       DateTime
  endAt         DateTime
  partySize     Int
  status        CapacityHoldStatus  @default(ACTIVE)
  expiresAt     DateTime?           // set to endAt+buffer; EXPIRED sweep uses this

  space       RestaurantSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  reservation Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  ledgerEvents LedgerEvent[]  @relation("LedgerEventCapacityHold")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([spaceId, reservationId])
  @@index([spaceId, status, startAt, endAt])
  @@index([status, expiresAt])
}


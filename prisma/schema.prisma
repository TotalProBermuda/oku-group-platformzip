  isPublicRepresentative Boolean                    @default(false)

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([userId, profileId, relationshipType])
  @@index([userId])
  @@index([profileId])
}

model ProfileRelationship {
  id               String                  @id @default(cuid())
  parentProfileId  String
  childProfileId   String
  relationshipType ProfileRelationshipType

  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  parentProfile Profile @relation("ParentProfile", fields: [parentProfileId], references: [id], onDelete: Cascade)
  childProfile  Profile @relation("ChildProfile", fields: [childProfileId], references: [id], onDelete: Cascade)

  @@unique([parentProfileId, childProfileId, relationshipType])
  @@index([parentProfileId])
  @@index([childProfileId])
}

model SeriesProfileAssignment {

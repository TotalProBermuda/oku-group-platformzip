// ─── Core models ────────────────────────────────────────────────────────────

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  imageUrl  String?
  phone     String?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  lastLoginAt      DateTime?
  forcedLogoutAt   DateTime?
  suspendedAt      DateTime?
  suspensionReason String?
  lockedAt         DateTime?
  lockReason       String?
  internalNotes    String?
  tags             String[]

  roles        UserRole[]
  auditLogs    UserAuditLog[] @relation("TargetUser")
  adminActions UserAuditLog[] @relation("PerformedBy")
  profile      UserProfile?

  influencer          InfluencerProfile?
  partner             PartnerProfile?
  investor            InvestorProfile?
  staff               StaffProfile?
  membership          Membership?
  founderApplications FounderMembershipApplication[]

  orders       Order[]
  tickets      Ticket[]
  IRAccessLog  IRAccessLog[]
  Notification Notification[]
  waitlists    ExperienceWaitlist[]
  newsletters  NewsletterSubscription[]
  checkins     ExperienceCheckin[]      @relation("CheckedInBy")
  referrer     Referrer?

  eventPermissions         EventPermission[]         @relation("EventPermissionUser")
  eventPermissionsGranted  EventPermission[]         @relation("EventPermissionGranter")
  eventReferrerAssignments EventReferrerAssignment[] @relation("EventReferrerAssignedUser")
  eventReferrersCreated    EventReferrerAssignment[] @relation("EventReferrerCreatedByUser")
  restaurantHost           RestaurantHostProfile?
  assignedChatSessions     HostChatSession[]         @relation("HostChatAssigned")

  referralActor ReferralActor?

  invitationsReceived EventInvitation[] @relation("InvitationRecipient")
  invitationsCreated  EventInvitation[] @relation("InvitationCreator")
  registrations       EventRegistrant[] @relation("UserRegistrations")

  attendanceEvents            AttendanceEvent[]    @relation("UserAttendances")
  recordedAttendances         AttendanceEvent[]    @relation("AttendanceRecordedBy")
  checkInLogs                 CheckInLog[]         @relation("CheckInLogScannedBy")
  linkedEntity                Entity?
  sponsorApplicationsReviewed SponsorApplication[] @relation("SponsorApplicationReviewer")
  sponsorAssignmentsCreated   SponsorAssignment[]  @relation("SponsorAssignmentCreator")

  createdProfiles     Profile[]            @relation("ProfileCreatedBy")
  updatedProfiles     Profile[]            @relation("ProfileUpdatedBy")
  accountProfileLinks AccountProfileLink[]

  streetsideScanConfig     StreetsideScanConfig?
  blockArrivalScans        ReservationBlockArrival[] @relation("BlockArrivalScannedBy")
  giftBagLogsGiven         GiftBagLog[]              @relation("GiftBagLogGivenBy")
  influencerInvitesCreated InfluencerInvite[]        @relation("InfluencerInviteCreatedBy")
  hostInfluencerContacts   HostInfluencerContact[]   @relation("HostInfluencerContacts")

  delegateSeatsCreated  PartnerDelegateSeat[] @relation("DelegateSeatCreator")
  delegateSeatsAccepted PartnerDelegateSeat[] @relation("DelegateSeatAcceptor")
  eventAccessGrants     UserEventAccess[]

  beneficiaryProfile          BeneficiaryProfile?
  beneficiaryOkuApprovals     BeneficiaryProfile[]  @relation("BeneficiaryOkuApprover")
  beneficiaryBankConfirms     BeneficiaryProfile[]  @relation("BeneficiaryBankConfirmer")
  beneficiaryDocumentUploads  BeneficiaryDocument[] @relation("BeneficiaryDocumentUploader")
}

model Role {
  key       RoleKey    @id
  label     String
  createdAt DateTime   @default(now())
  userRoles UserRole[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleKey   RoleKey
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleKey], references: [key], onDelete: Cascade)

  @@unique([userId, roleKey])
  @@index([roleKey])
}

model UserProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  language       String?
  preferredVenue VenueKey?
  marketingOptIn Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InfluencerProfile {
  id                      String                   @id @default(cuid())
  userId                  String                   @unique
  handle                  String?
  refCode                 String                   @unique
  commissionRateBps       Int                      @default(1000)
  approved                Boolean                  @default(false)
  // Public profile fields (from spec)
  displayName             String?
  headline                String?
  shortBio                String?
  longBio                 String?
  profileImageUrl         String?
  coverImageUrl           String?
  instagramUrl            String?
  tiktokUrl               String?
  youtubeUrl              String?
  websiteUrl              String?
  location                String?
  whatsapp                String?
  preferredLanguage       String?
  isPublic                Boolean                  @default(true)
  isVerified              Boolean                  @default(false)
  approvalStatus          InfluencerApprovalStatus @default(PENDING)
  payoutCycle             PayoutCycle              @default(MONTHLY)
  minPayoutThresholdCents Int                      @default(2500)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  user                    User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  series                  Series[]                        @relation("SeriesHost")
  seriesAsCommercialOwner Series[]                        @relation("SeriesCommercialOwner")
  ledgerEntries           LedgerEntry[]
  Order                   Order[]
  Attribution             Attribution[]
  experienceInfluencer    ExperienceInfluencer[]
  eventReferrersManaged   EventReferrerAssignment[]       @relation("CreatedByInfluencer")
  eventReferrersParent    EventReferrerAssignment[]       @relation("ParentInfluencer")
  subCommissionLedger     InfluencerSubCommissionLedger[]
  entity                  Entity?
}

model InfluencerInvite {
  id                String                 @id @default(cuid())
  token             String                 @unique
  invitedEmail      String
  invitedName       String
  commissionRateBps Int                    @default(1000)
  status            InfluencerInviteStatus @default(PENDING)
  seriesId          String?
  createdByUserId   String
  expiresAt         DateTime
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  series    Series? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  createdBy User    @relation("InfluencerInviteCreatedBy", fields: [createdByUserId], references: [id])

  @@index([token])
  @@index([invitedEmail])
}

model HostInfluencerContact {
  id                String            @id @default(cuid())
  hostUserId        String
  seriesId          String?
  name              String
  contactInfo       String?
  agreedAmountCents Int               @default(0)
  currency          String            @default("USD")
  paymentMethod     HostPaymentMethod @default(CASH)
  isPaid            Boolean           @default(false)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  host   User    @relation("HostInfluencerContacts", fields: [hostUserId], references: [id], onDelete: Cascade)
  series Series? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  @@index([hostUserId])
  @@index([seriesId])
}

model PartnerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  series              Series[]
  delegateSeats       PartnerDelegateSeat[]
  partnerReferrers    EventReferrerAssignment[]       @relation("PartnerReferrers")
  subCommissionLedger InfluencerSubCommissionLedger[] @relation("PartnerSubCommissionLedger")
}

// ── Partner Delegate Seats ────────────────────────────────────────────────
// Invite-first model: a partner creates a "seat" by email, the invitee
// accepts the secure link, and a UserEventAccess grant is issued scoped
// to a single Series OR a single Session. These seats are NOT operational
// hosts — they do not interact with Restaurant/Streetside Host logic.

enum PartnerDelegateRole {
  // Partner can lead an entire series — all sessions in scope.
  SERIES_CO_LEAD
  // Partner can lead a single session only.
  SESSION_CO_LEAD
  // Focused on guest list and check-in.
  GUEST_LIST_LEAD
}

enum PartnerDelegateSeatStatus {
  INVITED
  ACTIVE
  EXPIRED
  REVOKED
  REMOVED
}

model PartnerDelegateSeat {
  id              String  @id @default(cuid())
  partnerId       String
  createdByUserId String
  // Exactly one of seriesId / sessionId is set — enforced in app layer
  // (Prisma cannot express CHECK constraints).
  seriesId        String?
  sessionId       String?

  invitedName  String?
  invitedEmail String
  roleCode     PartnerDelegateRole
  status       PartnerDelegateSeatStatus @default(INVITED)

  // Snapshot of permission bundle at invite time. Resolved from roleCode.
  permissionsJson Json

  acceptedByUserId String?
  acceptedAt       DateTime?

  revokedAt       DateTime?
  revokedByUserId String?

  expiresAt DateTime?

  lastInvitedAt DateTime?
  inviteCount   Int       @default(1)

  // Optional sales capability — when isReferrerEnabled is true, accepting
  // the seat also mints an EventReferrerAssignment under this partner so
  // the existing /r/[code] + QR + sub-commission pipeline kicks in.
  // Partner pays the seat directly; platform tracks for reporting only.
  isReferrerEnabled    Boolean                     @default(false)
  commissionMode       EventReferrerCommissionMode @default(NONE)
  flatAmountCents      Int?
  perSeatAmountCents   Int?
  percentageBps        Int?
  referrerAssignmentId String?                     @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner            PartnerProfile           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  createdBy          User                     @relation("DelegateSeatCreator", fields: [createdByUserId], references: [id])
  acceptedBy         User?                    @relation("DelegateSeatAcceptor", fields: [acceptedByUserId], references: [id])
  series             Series?                  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  session            Session?                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  referrerAssignment EventReferrerAssignment? @relation("SeatReferrerAssignment", fields: [referrerAssignmentId], references: [id], onDelete: SetNull)
  invites            SeatInvite[]
  accessGrants       UserEventAccess[]

  @@index([partnerId, status])
  @@index([invitedEmail])
  @@index([seriesId])
  @@index([sessionId])
}

model SeatInvite {
  id          String @id @default(cuid())
  seatId      String
  // SHA-256 hex of the raw token (raw token only ever appears in the email link)
  tokenHash   String @unique
  sentToEmail String

  sentAt     DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  seat PartnerDelegateSeat @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@index([seatId])
  @@index([sentToEmail])
}

model UserEventAccess {
  id        String  @id @default(cuid())
  userId    String
  partnerId String
  seriesId  String?
  sessionId String?

  seatId          String
  roleCode        PartnerDelegateRole
  // Permission snapshot at grant time. Updated via explicit re-grant only.
  permissionsJson Json

  status String @default("active") // "active" | "removed"

  grantedAt DateTime  @default(now())
  removedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  seat    PartnerDelegateSeat @relation(fields: [seatId], references: [id], onDelete: Cascade)
  series  Series?             @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  session Session?            @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, seatId])
  @@index([userId, status])
  @@index([seriesId, status])
  @@index([sessionId, status])
}

model InvestorProfile {

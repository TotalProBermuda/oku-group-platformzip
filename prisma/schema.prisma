  createdAt       DateTime      @default(now())

  ticket    Ticket? @relation(fields: [ticketId], references: [id])
  scannedBy User?   @relation("CheckInLogScannedBy", fields: [scannedByUserId], references: [id])

  @@index([scannedCode])
  @@index([ticketId, createdAt])
  @@index([createdAt])
}

// ── Entity-Based Host System ──────────────────────────────────────────────────

enum EntityType {
  PERSON
  COMPANY
}

enum HostRole {
  PRIMARY_HOST
  CO_HOST
  SPONSOR
  BRAND_PARTNER
}

model Entity {
  id               String     @id @default(cuid())
  type             EntityType @default(PERSON)
  displayName      String
  /// Lightweight free-text classification (Hotel, Taxi Fleet, Tour Operator,
  /// Promoter Group, Restaurant, etc.). Used by the Referral Organization
  /// Resolver to label new approved entities created from the unresolved
  /// queue. Kept off `EntityType` enum to avoid affecting host/sponsor
  /// pickers. NULL on legacy rows.
  organizationKind String?
  logoUrl          String?
  description      String?
  websiteUrl       String?
  instagramUrl     String?
  twitterUrl       String?

  linkedUserId              String? @unique
  linkedInfluencerProfileId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  linkedUser              User?              @relation(fields: [linkedUserId], references: [id])
  linkedInfluencerProfile InfluencerProfile? @relation(fields: [linkedInfluencerProfileId], references: [id])

  seriesHosts         SeriesHost[]
  eventHosts          EventHost[]
  sponsorApplications SponsorApplication[]
  sponsorDeals        SponsorDeal[]
  sponsorAssignments  SponsorAssignment[]

  @@index([type])
}

model SeriesHost {
  id                 String   @id @default(cuid())
  seriesId           String
  entityId           String
  role               HostRole @default(PRIMARY_HOST)
  isFrontFacing      Boolean  @default(true)
  commissionShareBps Int?
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([seriesId, entityId])
  @@index([seriesId, sortOrder])
}

model EventHost {
  id                 String   @id @default(cuid())
  sessionId          String
  entityId           String
  role               HostRole @default(PRIMARY_HOST)
  isFrontFacing      Boolean  @default(true)
  commissionShareBps Int?
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  entity  Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([sessionId, entityId])
  @@index([sessionId, sortOrder])
}


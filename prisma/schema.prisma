// ─── Task #55: Deterministic INVU Trust Chain ────────────────────────────────

enum AttributionSessionKind {
  RESERVATION
  WALKIN
  // A ticket was purchased via an event-referrer QR / link. The session has
  // no reservationId; it carries orderId instead. Status is set to
  // VERIFIED_POS_SALE at creation (the payment is already confirmed).
  TICKET_PURCHASE
}

enum MatchTier {
  TIER1_DETERMINISTIC
  TIER2_OPERATIONAL
  // TIER2_PASSIVE — table+open-time match against an OKÜ AttributionSession
  // that the host seated but never explicitly bound to an INVU order. Same
  // shape as TIER2_OPERATIONAL (deterministic-enough to AUTO_MATCH) but with
  // a lower confidence (0.85) and a PASSIVE_CORRELATION binding type, so an
  // auditor can always tell the host did NOT manually confirm.
  TIER2_PASSIVE
  TIER3_HEURISTIC_REVIEW
  MANUAL_OVERRIDE
}

enum DeterministicMatchStatus {
  UNMATCHED
  AUTO_MATCHED
  REVIEW_PENDING
  MANUALLY_OVERRIDDEN
  REJECTED
}

enum InvuSyncStatus {
  NOT_SEEN
  OPEN
  CLOSED
  VOIDED
}

enum CommissionEligibilityStatus {
  NOT_ELIGIBLE
  ELIGIBLE_AUTO
  ELIGIBLE_REVIEW
  OVERRIDE_LOCKED
}

enum OperationalBindingType {
  TABLE_OPEN_BINDING
  MANUAL_ADMIN_BIND
  REFERENCE_WRITTEN_BACK
  // PASSIVE_CORRELATION — synthetic binding stamped by the Tier-2.5
  // matcher when an OKÜ TableSession opened at table T at time T uniquely
  // matches an INVU order opened at the same table within ±5 min, with no
  // host typing required. Treated identically to TABLE_OPEN_BINDING by the
  // commission pipeline (deterministic, but lower trust score because it
  // was inferred not declared).
  PASSIVE_CORRELATION
}

enum MatchProofType {
  DETERMINISTIC_REFERENCE
  DETERMINISTIC_BOOKING_CODE
  OPERATIONAL_BINDING
  HEURISTIC
  MANUAL_OVERRIDE
}

// Attribution lifecycle for QR/host bookings (Task: close attribution loop).
// CAPTURED        — diner scanned a per-actor QR (?ref=<code>) and the booking
//                   was created server-side; no table assigned yet.
// SEATED          — host has seated the party; tableLabel + tableSession known.
// POS_BIND_INTENT_RECORDED — local OperationalBinding written; OKÜ has captured
//                   the host's intent that this booking is sitting at INVU
//                   order #X. This is now the terminal pre-verification state
//                   (POS_REFERENCE_WRITTEN was retired Apr 28 2026 — vendor
//                   confirmed no API path to inject external references into
//                   INVU orders).
// VERIFIED_POS_SALE — INVU sync resolved the closed/paid sale to this session;
//                     commission allocations become eligible (the only mint gate).
// BOUND_TO_POS    — DEPRECATED. Predates the bind/intent split (Bucket D in
//                   docs/invu-execution-roadmap.md). Retained for one release
//                   cycle so old rows + replay buffers don't trip on a missing
//                   value; no new writers should produce it. Drop after the
//                   first clean reporting window post-rollout.
// CANCELED / EXPIRED — terminal failure states (no-show, walk-out, TTL).
enum AttributionSessionStatus {
  CAPTURED
  SEATED
  POS_BIND_INTENT_RECORDED
  BOUND_TO_POS
  VERIFIED_POS_SALE
  CANCELED
  EXPIRED
}

// Where the attribution session originated. Drives downstream UI labels and
// commission policy. QR_RESERVATION is the ?ref= public-reservation path
// added with this loop closure; HOST_CHECKIN/HOST_WALKIN are the legacy
// host-initiated paths; MANUAL_ADMIN is admin tooling override.
// TICKET_PURCHASE — ticket sold online via an event-referrer code; pairs
// with kind=TICKET_PURCHASE and orderId on the session.
enum AttributionSessionSource {
  QR_RESERVATION
  HOST_CHECKIN
  HOST_WALKIN
  MANUAL_ADMIN
  DIRECT
  TICKET_PURCHASE
}

// Anchor lifecycle for attribution sessions. Separates "where did this come
// from" (source) from "was the referrer chain fully written" (anchorStatus).
//  - ANCHORED:            the session was fully attributed at booking time.
//  - PENDING_ATTRIBUTION: the referral branch threw after a referrer context
//                         was resolved; the correct source is preserved and the
//                         failure reason is in anchorLastError. A background
//                         retry job will attempt to complete the anchoring.
//  - FAILED_REVIEW:       the retry job exhausted its retries; an admin must
//                         manually resolve using the preserved referrer context.
enum AnchorStatus {
  ANCHORED
  PENDING_ATTRIBUTION
  FAILED_REVIEW
}

model AttributionSession {
  id                String                 @id @default(cuid())
  kind              AttributionSessionKind
  venueId           String
  reservationId     String?                @unique
  // For TICKET_PURCHASE sessions: the confirmed order that produced this
  // session. Mutually exclusive with reservationId — exactly one will be
  // non-null depending on kind. The @unique constraint ensures a single
  // attribution session per order (race-safe).
  orderId           String?                @unique
  walkinContactName String?
  walkinPartySize   Int?
  walkinNotes       String?
  bookingCode       String                 @unique
  tableLabel        String?
  zoneId            String?
  hostUserId        String?
  hostProfileId     String?
  referralActorId   String?
  legacyReferrerId  String?
  // Proof-chain context — which exact ReferralLink produced the booking.
  // Written at booking time on the success path; preserved on PENDING_ATTRIBUTION
  // so the retry job and admin can re-anchor without losing the original context.
  referralLinkId    String?
  openedAt          DateTime               @default(now())
  closedAt          DateTime?
  createdByUserId   String?

  // Attribution loop lifecycle. `source` defaults to HOST_CHECKIN so legacy
  // rows backfill to the most common origin; new code MUST pass an explicit
  // source. `status` defaults to CAPTURED at insert and is advanced through
  // SEATED → BOUND_TO_POS → VERIFIED_POS_SALE by the host/INVU pipelines.
  // Denormalized invuOrderId/bindMethod let the host card render bind state
  // without a join to OperationalBinding (the source of truth there is still
  // OperationalBinding; these mirror the latest successful claim).
  source      AttributionSessionSource @default(HOST_CHECKIN)
  status      AttributionSessionStatus @default(CAPTURED)
  seatedAt    DateTime?
  boundAt     DateTime?
  verifiedAt  DateTime?
  invuOrderId String?
  bindMethod  String?

  // Anchor tracking fields (Task #180). Defaults to ANCHORED so all existing
  // rows are treated as fully attributed. New rows written in the referral
  // branch set PENDING_ATTRIBUTION when the write fails after a referrer
  // context was resolved; the retry worker flips to ANCHORED or FAILED_REVIEW.
  anchorStatus        AnchorStatus @default(ANCHORED)
  anchorRetryCount    Int          @default(0)
  anchorLastError     String?
  anchorLastAttemptAt DateTime?
  anchorResolvedAt    DateTime?

  venue        Venue                @relation(fields: [venueId], references: [id], onDelete: Cascade)
  reservation  Reservation?         @relation("ReservationAttributionSession", fields: [reservationId], references: [id])
  // Ticket-purchase back-relation (TICKET_PURCHASE sessions only).
  order        Order?               @relation("AttributionSessionOrder", fields: [orderId], references: [id])
  zone         Zone?                @relation(fields: [zoneId], references: [id])
  tableSession TableSession?        @relation("AttributionToTableSession")
  bindings     OperationalBinding[]
  matchProofs  MatchProof[]

  // Wired up so the host UI can render the attributing actor's display name
  // straight off the session — no second roundtrip needed. Both sides are
  // optional because a HOST_CHECKIN session has neither, and a QR_RESERVATION
  // session may carry only one of the two depending on whether the actor
  // came in through the new ReferralActor chain or the legacy Referrer table.
  referralActor  ReferralActor? @relation("AttributionSessionActor", fields: [referralActorId], references: [id])
  legacyReferrer Referrer?      @relation("AttributionSessionLegacy", fields: [legacyReferrerId], references: [id])
  ledgerEvents   LedgerEvent[]  @relation("LedgerEventAttributionSession")

  @@index([venueId, openedAt])
  @@index([referralActorId])
  @@index([hostUserId])
  @@index([zoneId])
  @@index([status])
  @@index([source])
  @@index([orderId])
  @@index([anchorStatus])
  @@index([referralLinkId])
}

model OperationalBinding {
  id                   String                 @id @default(cuid())
  attributionSessionId String
  invuOrderId          String
  bindingType          OperationalBindingType
  boundByUserId        String?
  supportingDataJson   Json
  createdAt            DateTime               @default(now())

  attributionSession AttributionSession @relation(fields: [attributionSessionId], references: [id], onDelete: Cascade)

  @@unique([invuOrderId, attributionSessionId])
  @@unique([invuOrderId], name: "OperationalBinding_invuOrderId_global_key")
  @@index([attributionSessionId])
}

model MatchProof {
  id                    String         @id @default(cuid())
  matchProofType        MatchProofType
  matchTier             MatchTier
  confidence            Float
  attributionSessionId  String?
  reservationId         String?
  invuOrderNormalizedId String?
  invuOrderId           String?
  bookingCode           String?
  sourceField           String?
  supportingDataJson    Json
  createdByUserId       String?
  createdAt             DateTime       @default(now())

  attributionSession AttributionSession? @relation(fields: [attributionSessionId], references: [id])
  reservation        Reservation?        @relation(fields: [reservationId], references: [id])
  tableSessions      TableSession[]

  @@index([attributionSessionId])
  @@index([invuOrderId])
  @@index([reservationId])
  @@index([matchTier])
}

model ManualMatchOverride {
  id                 String   @id @default(cuid())
  tableSessionId     String   @unique
  performedByUserId  String
  reason             String
  previousMatchProof Json?
  createdAt          DateTime @default(now())

  tableSession TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
}

// ─── Venue Menus (DB-backed source of truth) ───────────────────────────────
// Mirrors the legacy types in src/data/venues/menus.ts. Translatable fields
// are stored as Json holding { en, es, pt }. Plain string fallback supported.

enum VenueMenuType {
  FOOD
  DRINKS
}

model VenueMenuRecord {
  id           String            @id @default(cuid())
  venueSlug    String // matches Venue.slug or static "oku"|"catch"|"terrace"
  menuType     VenueMenuType
  menuTitle    Json // { en, es, pt } | string
  intro        Json?
  pdfUrl       String?
  sortOrder    Int               @default(0)
  isPublished  Boolean           @default(true)
  // House menu = the venue's standing menu shown on the venue page.
  // Event-only duplicates set isHouseMenu=false so they don't leak to
  // venue-wide listings. House-menu uniqueness per (venueSlug, menuType)
  // is enforced at the application layer because Prisma cannot express
  // partial unique indexes portably.
  isHouseMenu  Boolean           @default(true)
  // When this menu was created by duplicating another, link to the source
  // for traceability ("derived from House Food Menu on 2026-04-23").
  parentMenuId String?
  parent       VenueMenuRecord?  @relation("MenuLineage", fields: [parentMenuId], references: [id], onDelete: SetNull)
  copies       VenueMenuRecord[] @relation("MenuLineage")

  sections   MenuSectionRecord[]
  eventLinks EventMenuLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueSlug, menuType])
  @@index([venueSlug])
  @@index([parentMenuId])
}

// Many-to-many between Series (events) and VenueMenuRecord. A single
// "Tasting Menu Vol 3" can be reused across multiple events, and one event
// can carry multiple menus (e.g. food + drinks).
model EventMenuLink {
  id        String   @id @default(cuid())
  seriesId  String
  menuId    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  series Series          @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  menu   VenueMenuRecord @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([seriesId, menuId])
  @@index([seriesId])
  @@index([menuId])
}

model MenuSectionRecord {
  id          String @id @default(cuid())
  menuId      String
  title       Json // { en, es, pt } | string
  subtitle    Json?
  description Json?
  sortOrder   Int    @default(0)

  menu  VenueMenuRecord  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items MenuItemRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuId])
}

model MenuItemRecord {
  id          String   @id @default(cuid())
  sectionId   String
  name        Json // { en, es, pt } | string
  description Json?
  price       String?
  dietary     String[] @default([])
  tags        String[] @default([])
  sortOrder   Int      @default(0)
  isAvailable Boolean  @default(true)

  section MenuSectionRecord @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
}

// ─── ProofPay — Canonical Ledger Events ─────────────────────────────────────
// A shared event vocabulary for attribution, reservation, and capacity events.
// Every material state change in the platform should emit a LedgerEvent so
// admins, investors, and referrers can read the same proof of what happened.
// Deduplication is ingest-time: when the same (sourceRecordId, idempotencyKey)
// arrives again, the existing row's duplicateCount is incremented and
// lastDuplicateAt is updated — no separate error row is written.

enum LedgerEventType {
  // Referral lifecycle
  REFERRAL_SCANNED

  // Reservation lifecycle
  RESERVATION_REQUESTED
  RESERVATION_CONFIRMED
  RESERVATION_MODIFIED
  RESERVATION_CANCELLED
  RESERVATION_NO_SHOW
  GUEST_ARRIVED
  GUEST_SEATED

  // Capacity lifecycle
  CAPACITY_HOLD_CREATED
  CAPACITY_HOLD_RELEASED
  CAPACITY_WARNING_SHOWN
  CAPACITY_OVERRIDDEN_BY_HOST

  // Attribution anchor lifecycle
  ATTRIBUTION_ANCHOR_PENDING
  ATTRIBUTION_ANCHOR_RESOLVED
  ATTRIBUTION_ANCHOR_FAILED

  // POS / financial events
  // Emitted when an INVU (or equivalent POS) check closes and triggers
  // commission minting. Distinct from attribution lifecycle events so
  // the two concerns remain independently queryable.
  POS_CHECK_CLOSED
}

enum ConfidenceClass {
  // POS-sourced event: verified by INVU or equivalent payment system
  VERIFIED_POS_EVENT
  // Partner-reported event: trusted third-party source (no POS verification)
  PARTNER_REPORTED_EVENT
  // Customer-claimed event: guest self-reported (lowest automated trust)
  CUSTOMER_CLAIMED_EVENT
  // Flagged for manual review by an admin before any downstream action
  MANUAL_REVIEW_EVENT
  // Derived or interpolated — no direct evidence, used for analytics only
  ESTIMATED_EVENT
}

model LedgerEvent {
  id              String           @id @default(cuid())
  eventType       LedgerEventType
  sourceSystem    String           // e.g. "invu", "reservations_api", "host_ops"
  sourceConnector String?          // e.g. "invu_v2", "resend", null for internal
  sourceRecordId  String?          // external ID from the originating system (nullable for internal events)
  idempotencyKey  String           // deterministic key; callers must mint this before calling emitLedgerEvent
  occurredAt      DateTime
  receivedAt      DateTime         @default(now())
  confidenceClass ConfidenceClass
  rawPayloadRef   String?          // reference to blob storage or a JSON snapshot
  auditTraceId    String?          // cross-system correlation ID (e.g. X-Request-ID)

  // Deduplication counters — updated in-place when the same event arrives again
  duplicateCount    Int       @default(0)
  lastDuplicateAt   DateTime?

  // Nullable FKs to domain entities — set whichever apply to this event
  attributionSessionId   String?
  reservationId          String?
  capacityHoldId         String?
  commissionAllocationId String?

  // Payload snapshot (JSONB) — structured fields extracted from rawPayloadRef
  // for fast querying without full blob retrieval
  payload Json?

  attributionSession   AttributionSession?   @relation("LedgerEventAttributionSession", fields: [attributionSessionId], references: [id], onDelete: SetNull)
  reservation          Reservation?          @relation("LedgerEventReservation", fields: [reservationId], references: [id], onDelete: SetNull)
  capacityHold         CapacityHold?         @relation("LedgerEventCapacityHold", fields: [capacityHoldId], references: [id], onDelete: SetNull)
  commissionAllocation CommissionAllocation? @relation("LedgerEventCommissionAllocation", fields: [commissionAllocationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unique deduplication index for external-source events (sourceRecordId IS NOT NULL).
  // Including sourceSystem prevents cross-connector collision: two different external
  // systems that happen to use the same recordId + idempotencyKey format do not collide.
  // sourceConnector is intentionally excluded — it is nullable and PostgreSQL NULL!=NULL
  // semantics would silently skip deduplication when connector is absent.
  // Internal (null-sourceRecordId) events are deduplicated by the partial unique index
  // in the migration: CREATE UNIQUE INDEX ... WHERE sourceRecordId IS NULL.
  @@unique([sourceSystem, sourceRecordId, idempotencyKey], name: "LedgerEvent_dedup_key")
  @@index([eventType])
  @@index([idempotencyKey])
  @@index([attributionSessionId])
  @@index([reservationId])
  @@index([capacityHoldId])
  @@index([commissionAllocationId])
  @@index([occurredAt])
  @@index([confidenceClass])
}

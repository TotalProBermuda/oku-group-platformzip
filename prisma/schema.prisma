  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  // Assignments where THIS host is the recipient/operator (delegation
  // from a partner/influencer seat).
  referrerAssignments EventReferrerAssignment[]       @relation("HostReferrerAssignments")
  // Assignments where THIS host is the commission anchor (their own
  // personal streetside referral code).
  ownedReferrers      EventReferrerAssignment[]       @relation("HostOwnedReferrers")
  // Sub-commission reporting rows for host-anchored assignments (the
  // restaurant settles payout off-platform; we record amounts here).
  subCommissionLedger InfluencerSubCommissionLedger[] @relation("HostSubCommissionLedger")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@index([parentProfileId])
}

model ReservationStatusLog {
  id              String   @id @default(cuid())
  reservationId   String
  fromStatus      String?
  toStatus        String
  changedByUserId String?
  changedByLabel  String?
  lossReason      String?
  lossReasonNotes String?
  notes           String?
  changedAt       DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@index([changedAt])
}

// ─── Phase 1: Unified ReferralActor Foundation ────────────────────────────────
// ReferralActor is the single abstraction for any entity that can refer guests.
// It wraps legacy Referrer records and EventReferrerAssignments via compat links.
// Existing FK relationships are preserved — this layer sits ABOVE them.

enum ReferralActorType {
  STREETSIDE_HOST
  TAXI_DRIVER
  UBER_DRIVER
  TOUR_GUIDE
  HOTEL_CONCIERGE
  INFLUENCER_SUB_REFERRER
  PROMOTER
  PRIVATE_NETWORK
  OTHER
}

enum ReferralActorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ReferralScopeType {
  GLOBAL
  VENUE
  SERIES
  CAMPAIGN
}

/// Product line a ReferralAssignment promotes. Lets a single ReferralActor
/// hold multiple, intent-bucketed offers (Restaurant tonight, Event next
/// Friday, 12-month membership push). Orthogonal to scopeType — scopeType
/// answers "where does this apply?" while offerType answers "what is the
/// guest being invited to?".
enum OfferType {
  RESTAURANT
  EVENT
  SERIES
  MEMBERSHIP
  PRIVATE_DINING
  PACKAGE
}

/// Lifecycle of a ReferralAssignment. Drives admin UI filters and share-surface
/// visibility:
///   - DRAFT     — created but not yet shareable (admin still configuring)
///   - ACTIVE    — live, surfaces in the referrer wallet
///   - PAUSED    — temporarily hidden, links still resolve (read-only)
///   - RETIRED   — permanently ended, demoted to "Past activity"
enum ReferralAssignmentStatus {
  DRAFT
  ACTIVE
  PAUSED
  RETIRED
}

enum ReferralCompensationMode {
  NONE
  PERCENT_OF_TRANSACTION
  PERCENT_OF_PARENT_COMMISSION
  FLAT_PER_COVER
  FLAT_PER_PARTY
}

/// Extensible operator-type definitions. Each row is either a built-in type
/// seeded from the `ReferralActorType` enum (isBuiltin=true, with
/// `legacyEnumValue` populated) or a custom type created by an admin
/// (isBuiltin=false, `legacyEnumValue` defaults to OTHER for backward compat
/// with code paths still keyed off the enum).
model ReferralActorTypeDef {
  id               String                   @id @default(cuid())
  /// Stable slug used as the FK target on ReferralActor (e.g. "streetside-host", "yacht-captain").
  code             String                   @unique
  /// Display label shown in dropdowns (English; can be localized in i18n keys later).
  label            String
  description      String?
  /// Optional emoji or icon name for visual differentiation in pickers.
  icon             String?
  /// True for the 9 seeded enum-derived types; false for admin-created customs.
  isBuiltin        Boolean                  @default(false)
  /// Mapping back to the legacy ReferralActorType enum so downstream code that
  /// still reads `ReferralActor.actorType` keeps working. Custom types use OTHER.
  legacyEnumValue  ReferralActorType
  /// Default compensation knobs prefilled in the AddOperatorModal when picked.
  defaultCompMode  ReferralCompensationMode @default(PERCENT_OF_TRANSACTION)
  defaultRateBps   Int?
  defaultFlatCents Int?
  /// Default platform RBAC role granted when a User is created from this type
  /// (null = no role auto-grant, modal stays in REFERRER fallback).
  defaultRbacRole  String?
  /// Display order in the picker (lower = earlier).
  sortOrder        Int                      @default(100)
  isActive         Boolean                  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?

  actors ReferralActor[]

  @@index([isActive, sortOrder])
}

model ReferralActor {
  id               String                @id @default(cuid())
  actorType        ReferralActorType
  /// Slug pointing into ReferralActorTypeDef. Optional during the migration
  /// window; new creates always set both this and the legacy `actorType`.
  actorTypeCode    String?
  actorTypeDef     ReferralActorTypeDef? @relation(fields: [actorTypeCode], references: [code])
  displayName      String
  organizationName String?
  phone            String?
  email            String?
  whatsapp         String?
  status           ReferralActorStatus   @default(ACTIVE)
  metadataJson     Json?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  legacyReferrerId String?   @unique
  legacyReferrer   Referrer? @relation(fields: [legacyReferrerId], references: [id])

  legacyEventReferrerAssignmentId String?                  @unique
  legacyEventReferrerAssignment   EventReferrerAssignment? @relation(fields: [legacyEventReferrerAssignmentId], references: [id])

  assignments         ReferralAssignment[]
  links               ReferralLink[]
  commissions         CommissionEntry[]
  attributionSessions AttributionSession[] @relation("AttributionSessionActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([actorType, status])
  @@index([userId])
}

model ReferralAssignment {
  id              String        @id @default(cuid())
  referralActorId String
  referralActor   ReferralActor @relation(fields: [referralActorId], references: [id], onDelete: Cascade)

  scopeType ReferralScopeType @default(GLOBAL)
  scopeId   String?

  /// Product line this assignment promotes (RESTAURANT/EVENT/SERIES/
  /// MEMBERSHIP/PRIVATE_DINING/PACKAGE). Drives intent-bucketing on the
  /// referrer mobile share surface (Today/This week/Restaurants/Events).
  /// Nullable during the migration window for legacy assignments.
  offerType OfferType?
  /// Optional FK target tied to offerType (e.g. Series.id when
  /// offerType=EVENT|SERIES, Venue.id when RESTAURANT, MembershipPlan.id
  /// when MEMBERSHIP). Validated at the service layer — no Prisma FK so
  /// a single column can address multiple parent tables.
  offerId   String?
  /// Optional human label cached at write-time (e.g. "OKÜ Friday Sept 12 –
  /// Sunset Set"). Lets the share surface render fast without N+1 lookups.
  offerLabel String?
  /// Optional time window the offer is valid for, used to bucket into
  /// Today/This week/Past on the share surface.
  offerStartAt DateTime?
  offerEndAt   DateTime?

  parentEntityType String?
  parentEntityId   String?

  isCommissionEligible Boolean                  @default(false)
  compensationMode     ReferralCompensationMode @default(NONE)
  rateBps              Int?
  flatAmountCents      Int?

  legacyCompensationPlanId String?

  /// New canonical commission-plan reference for this assignment. Optional
  /// FK-less column to keep the model usable across legacy plan rows that
  /// may have been deleted; service layer dereferences when present.
  commissionPlanId String?

  /// Optional pre-rendered QR payload (data URL or short opaque string)
  /// cached at write-time so the share surface can render the QR without
  /// re-encoding per request. The canonicalCode below remains the source
  /// of truth — qrPayload is a render cache only.
  qrPayload String?

  isActive Boolean @default(true)

  /// Lifecycle status (DRAFT/ACTIVE/PAUSED/RETIRED). Coexists with the
  /// older boolean `isActive` for backward compatibility — service layer
  /// keeps them in sync (status=ACTIVE ⇔ isActive=true).
  status ReferralAssignmentStatus @default(ACTIVE)

  /// Provenance: who created this assignment? `createdByUserId` is the
  /// auth subject (admin or partner), and `creatorRole` records WHICH
  /// surface they came from so audit reconstruction can tell apart an
  /// admin-issued assignment from a partner self-service one.
  /// Optional FK-less columns to avoid cascade complexity across roles.
  createdByUserId String?
  creatorRole     String?

  /// Optional canonical assignment-level code mirroring the primary
  /// ReferralLink.code for fast lookup / QR rendering on the share surface.
  /// The unique source of truth for resolution is still ReferralLink.code
  /// (so partners can rotate links), but storing the canonical code here
  /// lets `/r/[code]` shortcuts and admin lists render without a join.
  canonicalCode String? @unique

  links ReferralLink[]
  attributedOrders Order[] @relation("OrderReferralAssignment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referralActorId])
  @@index([scopeType, scopeId])
  @@index([isActive])
  @@index([status])
  @@index([createdByUserId])
  @@index([offerType, offerStartAt])
  @@index([referralActorId, isActive, offerStartAt])
}

model ReferralLink {
  id                   String  @id @default(cuid())
  referralActorId      String
  referralAssignmentId String?

  referralActor      ReferralActor       @relation(fields: [referralActorId], references: [id], onDelete: Cascade)
  referralAssignment ReferralAssignment? @relation(fields: [referralAssignmentId], references: [id])

  code          String  @unique
  url           String?
  qrCodeDataUrl String?

  clickCount    Int       @default(0)
  lastClickedAt DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referralActorId])
  @@index([code])
}

// ─── Event Invitation Engine ──────────────────────────────────────────────────

model EventInvitation {
  id              String                    @id @default(cuid())
  seriesId        String
  recipientUserId String?
  recipientEmail  String
  recipientName   String?
  audienceSegment InviteAudienceMode
  status          InvitationStatus          @default(SENT)
  inviteToken     String                    @unique @default(cuid())
  responseSource  InvitationResponseSource?

  sentAt          DateTime  @default(now())
  openedAt        DateTime?
  respondedAt     DateTime?
  declinedAt      DateTime?
  rsvpStartedAt   DateTime?
  rsvpConfirmedAt DateTime?

  flyerImageUrl   String?
  createdByUserId String

  // Partner / admin single-guest invitations: indicates intent for the
  // invitee to receive a comp ticket on RSVP, against a specific ticket
  // type. Issuance still happens on the RSVP path (out of scope for the
  // first portal iteration); these fields capture the partner's choice
  // so admins can honor it at check-in or via a follow-up auto-issue.
  isCompInvite         Boolean @default(false)
  intendedTicketTypeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  series             Series           @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  recipientUser      User?            @relation("InvitationRecipient", fields: [recipientUserId], references: [id])
  createdBy          User             @relation("InvitationCreator", fields: [createdByUserId], references: [id])
  intendedTicketType TicketType?      @relation("InvitationIntendedTicketType", fields: [intendedTicketTypeId], references: [id])
  registrant         EventRegistrant?

  @@index([seriesId])
  @@index([recipientUserId])
  @@index([inviteToken])
  @@index([status])
}

model EventRegistrant {
  id                 String                 @id @default(cuid())
  seriesId           String
  userId             String
  invitationId       String?                @unique
  registrationStatus RegistrationStatus     @default(RSVP_CONFIRMED)
  sourceType         RegistrationSourceType @default(INVITATION)
  ticketId           String?                @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  series     Series           @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  user       User             @relation("UserRegistrations", fields: [userId], references: [id])
  invitation EventInvitation? @relation(fields: [invitationId], references: [id])
  ticket     Ticket?          @relation(fields: [ticketId], references: [id])

  @@unique([seriesId, userId])
  @@index([seriesId])
  @@index([userId])
}

// ── UGC TRANSLATION LAYER ────────────────────────────────────────────────────

enum ContentTranslationStatus {
  PENDING
  COMPLETED
  FAILED
  STALE
}

model ContentTranslation {

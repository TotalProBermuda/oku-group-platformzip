  apiPasswordEncrypted String
  accessTokenEncrypted String?
  accessTokenMasked    String?
  accessTokenIssuedAt  DateTime?
  accessTokenExpiresAt DateTime?
  tokenLastRotatedAt   DateTime?
  apiUserType          ApiUserType          @default(API_BASIC)
  apiUserExpiresAt     DateTime?
  branchScoped         Boolean              @default(false)
  status               InvuCredentialStatus @default(DISCONNECTED)
  lastAuthSucceededAt  DateTime?
  lastAuthFailedAt     DateTime?
  lastAuthError        String?
  isEnabled            Boolean              @default(true)
  createdByUserId      String?
  updatedByUserId      String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  venue          Venue                      @relation(fields: [venueId], references: [id])

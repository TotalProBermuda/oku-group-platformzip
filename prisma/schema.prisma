  updatedAt     DateTime             @updatedAt

  deal SponsorDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, isActive])
  @@index([placementType, isActive])
}

// ── Sponsor Placement Engine ──────────────────────────────────────────────────

model SponsorTier {
